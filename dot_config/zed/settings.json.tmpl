// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //
  // Style/Theme/Font
  //
  "icon_theme": "Zed (Default)",
  "ui_font_family": "HackGen",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
  "text_rendering_mode": "grayscale",
  "outline_panel": {
    "button": true,
    "file_icons": true,
    "git_status": true,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  //
  // Editor
  //
  "auto_indent_on_paste": false,
  "show_whitespaces": "all",
  "ensure_final_newline_on_save": true,
  "wrap_guides": [
    80,
    160
  ],
  "soft_wrap": "none",
  "tab_size": 2,
  "ui_font_size": 16,
  "buffer_font_size": 10.5,
  "buffer_font_family": "HackGen",
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New"
  ],
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  //
  // Terminal
  //
  "terminal": {
    "dock": "bottom",
    "font_size": 10.5,
    "font_family": "HackGen Console NF",
    "font_fallbacks": [
      "Menlo",
      "Monaco",
      "Courier New"
    ],
  },
  //
  // Action on Format
  //
  "code_actions_on_format": {
    "source.organizeImports": true,
    "source.fixAll.eslint": true,
  },
  "format_on_save": "on",
  "formatter": "language_server",
  //
  // AutoComplite
  //
  {{- if eq .isConfidential true}}
  "show_edit_predictions": false, // !important
  "show_completions_on_input": false, // !important
  {{- else }}
  "show_edit_predictions": true,
  "show_completions_on_input": true,
  {{- end }}
  //
  // AI Agent
  //
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "copilot", // !important
  },
  //
  // Telemetry
  //
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  //
  // Kay Binding
  //
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "cmd_or_ctrl",
  //
  // Languages
  //
  "file_types": {
    "Plan Text": [
      ".gitcommit_template"
    ],
    "YAML": [
      ".git_consistent"
    ],
    "TOML": [
      "*.toml.tmpl"
    ],
    "Shell Script": [
      "*.zsh.tmpl"
    ],
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "solargraph",
        "rubocop",
        "!ruby-lsp",
        "..."
      ],
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ],
        },
      },
      "format_on_save": "on",
    },
  },
  "lsp": {
    "solargraph": {
      "initialization_options": {
        "diagnostics": true,
        "formatting": true,
      },
    },
  },
}
